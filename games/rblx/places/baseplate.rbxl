      <Item class="LocalScript" referent="RBX7">
        <Properties>
          <bool name="Disabled">false</bool>
          <string name="Name">PeerMultiplayerSync</string>
          <ProtectedString name="Source"><![CDATA[
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local player = Players.LocalPlayer

-- Build the RemotePlayer character model purely from code (no Studio needed)
local rig = Instance.new("Model")
rig.Name = "RemotePlayer"
rig.Parent = workspace

local function makePart(name, size, colorName, offset)
	local p = Instance.new("Part")
	p.Name = name
	p.FormFactor = Enum.FormFactor.Custom
	p.Size = size
	p.BrickColor = BrickColor.new(colorName)
	p.Anchored = true
	p.CanCollide = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = rig
	return p, offset
end

local torso, torsoOff = makePart("Torso", Vector3.new(2, 2, 1), "Bright blue", CFrame.new(0, 0, 0))
local head, headOff = makePart("Head", Vector3.new(1.2, 1.2, 1.2), "Bright yellow", CFrame.new(0, 1.6, 0))
local lArm, lArmOff = makePart("Left Arm", Vector3.new(1, 2, 1), "Bright yellow", CFrame.new(-1.5, 0, 0))
local rArm, rArmOff = makePart("Right Arm", Vector3.new(1, 2, 1), "Bright yellow", CFrame.new(1.5, 0, 0))
local lLeg, lLegOff = makePart("Left Leg", Vector3.new(1, 2, 1), "Br. yellowish green", CFrame.new(-0.5, -2, 0))
local rLeg, rLegOff = makePart("Right Leg", Vector3.new(1, 2, 1), "Br. yellowish green", CFrame.new(0.5, -2, 0))

local headMesh = Instance.new("SpecialMesh")
headMesh.MeshType = Enum.MeshType.Head
headMesh.Scale = Vector3.new(1.25, 1.25, 1.25)
headMesh.Parent = head

local currentCF = CFrame.new(0, -100, 0) -- Hide underground until a friend connects

RunService.RenderStepped:Connect(function()
	local char = player and player.Character
	local root = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso"))
	if root then
		local pos = root.Position
		local _, rotY, _ = root.CFrame:ToEulerAnglesYXZ()
		local speed = root.Velocity.Magnitude
		local data = string.format("%.2f,%.2f,%.2f,%.2f,%.1f", pos.X, pos.Y, pos.Z, rotY, speed)
		pcall(function()
			writefile("/content/local_player.txt", data)
		end)
	end

	local ok, raw = pcall(function()
		return readfile("/content/remote_player.txt")
	end)

	if ok and raw and #raw > 0 then
		local x, y, z, ry = raw:match("([^,]+),([^,]+),([^,]+),([^,]+)")
		if x and y and z and ry then
			local target = CFrame.new(tonumber(x), tonumber(y), tonumber(z)) * CFrame.Angles(0, tonumber(ry), 0)
			currentCF = currentCF:Lerp(target, 0.35)
			torso.CFrame = currentCF * torsoOff
			head.CFrame = currentCF * headOff
			lArm.CFrame = currentCF * lArmOff
			rArm.CFrame = currentCF * rArmOff
			lLeg.CFrame = currentCF * lLegOff
			rLeg.CFrame = currentCF * rLegOff
		end
	end
end)
]]></ProtectedString>
