  <Item class="StarterPlayer" referent="RBX5">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="RBX6">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="RBX7">
        <Properties>
          <bool name="Disabled">false</bool>
          <string name="Name">PeerMultiplayerSync</string>
          <ProtectedString name="Source"><![CDATA[
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local player = Players.LocalPlayer
local myName = (player and player.Name) or "Player1"

pcall(function() HttpService.HttpEnabled = true end)

-- 1. Build 2016-style Top-Right Leaderboard UI
local pg = player:WaitForChild("PlayerGui")
local gui = Instance.new("ScreenGui")
gui.Name = "PeerLeaderboard"
gui.ResetOnSpawn = false
gui.Parent = pg

local board = Instance.new("Frame")
board.Name = "List"
board.Size = UDim2.new(0, 170, 0, 32)
board.Position = UDim2.new(1, -180, 0, 8)
board.BackgroundColor3 = Color3.new(0.12, 0.13, 0.14)
board.BackgroundTransparency = 0.35
board.BorderSizePixel = 0
board.Parent = gui

local function makeRow(y, text)
	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(1, -16, 0, 24)
	lbl.Position = UDim2.new(0, 8, 0, y)
	lbl.BackgroundTransparency = 1
	lbl.TextColor3 = Color3.new(1, 1, 1)
	lbl.Font = Enum.Font.SourceSansBold
	lbl.FontSize = Enum.FontSize.Size18
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.Text = text
	lbl.Parent = board
	return lbl
end

local row1 = makeRow(4, myName)
local row2 = makeRow(28, "")
row2.Visible = false

-- 2. Build RemotePlayer R6 Model
local rig = Instance.new("Model")
rig.Name = "Friend"
rig.Parent = workspace

local function makePart(name, size, colorName, offset)
	local p = Instance.new("Part")
	p.Name = name
	p.FormFactor = Enum.FormFactor.Custom
	p.Size = size
	p.BrickColor = BrickColor.new(colorName)
	p.Anchored = true
	p.CanCollide = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = rig
	return p, offset
end

local torso, torsoOff = makePart("Torso", Vector3.new(2, 2, 1), "Bright blue", CFrame.new(0, 0, 0))
local head, headOff = makePart("Head", Vector3.new(1.2, 1.2, 1.2), "Bright yellow", CFrame.new(0, 1.5, 0))
local lArm, lArmOff = makePart("Left Arm", Vector3.new(1, 2, 1), "Bright yellow", CFrame.new(-1.5, 0, 0))
local rArm, rArmOff = makePart("Right Arm", Vector3.new(1, 2, 1), "Bright yellow", CFrame.new(1.5, 0, 0))
local lLeg, lLegOff = makePart("Left Leg", Vector3.new(1, 2, 1), "Br. yellowish green", CFrame.new(-0.5, -2, 0))
local rLeg, rLegOff = makePart("Right Leg", Vector3.new(1, 2, 1), "Br. yellowish green", CFrame.new(0.5, -2, 0))

local headMesh = Instance.new("SpecialMesh")
headMesh.MeshType = Enum.MeshType.Head
headMesh.Scale = Vector3.new(1.25, 1.25, 1.25)
headMesh.Parent = head

local bb = Instance.new("BillboardGui")
bb.Size = UDim2.new(0, 140, 0, 30)
bb.StudsOffset = Vector3.new(0, 2, 0)
bb.AlwaysOnTop = true
bb.Parent = head
local nameTag = Instance.new("TextLabel")
nameTag.Size = UDim2.new(1, 0, 1, 0)
nameTag.BackgroundTransparency = 1
nameTag.TextColor3 = Color3.new(1, 1, 1)
nameTag.TextStrokeTransparency = 0.3
nameTag.Font = Enum.Font.SourceSansBold
nameTag.FontSize = Enum.FontSize.Size18
nameTag.Text = "Player2"
nameTag.Parent = bb

local targetCF = CFrame.new(0, -100, 0)
local currentCF = targetCF

-- Background loop so network calls don't block rendering
spawn(function()
	while wait(0.08) do
		local char = player and player.Character
		local root = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso"))
		local payload = ""
		if root then
			local pos = root.Position
			local _, rotY, _ = root.CFrame:ToEulerAnglesYXZ()
			payload = string.format("%.2f,%.2f,%.2f,%.2f", pos.X, pos.Y, pos.Z, rotY)
		end

		local url = "https://woodvilleweather.com" .. payload
		local ok, res = pcall(function()
			return HttpService:GetAsync(url, true)
		end)
		if not ok then
			ok, res = pcall(function()
				return game:HttpGet(url, true)
			end)
		end

		if ok and res and #res > 0 then
			local connFlag, localName, remote = res:match("^(%d)|([^|]*)|(.*)$")
			if localName and #localName > 0 then
				row1.Text = localName
			end
			if connFlag == "1" then
				row2.Visible = true
				board.Size = UDim2.new(0, 170, 0, 56)
				local coords, rName = remote:match("^([^|]+)|?(.*)$")
				if rName and #rName > 0 then
					row2.Text = rName
					nameTag.Text = rName
				else
					row2.Text = "Player2"
				end
				if coords then
					local x, y, z, ry = coords:match("([^,]+),([^,]+),([^,]+),([^,]+)")
					if x and y and z and ry then
						targetCF = CFrame.new(tonumber(x), tonumber(y), tonumber(z)) * CFrame.Angles(0, tonumber(ry), 0)
					end
				end
			else
				row2.Visible = false
				board.Size = UDim2.new(0, 170, 0, 32)
				targetCF = CFrame.new(0, -100, 0)
			end
		end
	end
end)

RunService.RenderStepped:Connect(function()
	currentCF = currentCF:Lerp(targetCF, 0.35)
	torso.CFrame = currentCF * torsoOff
	head.CFrame = currentCF * headOff
	lArm.CFrame = currentCF * lArmOff
	rArm.CFrame = currentCF * rArmOff
	lLeg.CFrame = currentCF * lLegOff
	rLeg.CFrame = currentCF * rLegOff
end)
]]></ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
</roblox>
